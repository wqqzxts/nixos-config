(include "./bar/modules/power.yuck")
(include "./bar/modules/clock.yuck")
(include "./bar/modules/weather.yuck")

(include "./bar/modules/cava.yuck")

(include "./bar/modules/language.yuck")
(include "./bar/modules/battery.yuck")
(include "./bar/modules/status.yuck")

(defvar anim-duration 375)

(defwindow ewwbar
  :monitor 0
  :geometry (geometry :x 0
                      :y 0
                      :width "100%"
                      :height "50px"
                      :anchor "top center"
            )
  :stacking "fg"
  :exclusive true
  (eww-bar-placeholder)
)

(defwidget eww-bar-placeholder []
  (centerbox
    :class "ewwbar-ph"
    (box
      :spacing 5
      :space-evenly false
      (widget-power)
      (widget-clock)
      (widget-weather)
    )
    (box
      :space-evenly false
      (widget-cava)
    )
    (box
      :spacing 5
      :space-evenly false
      :halign "end"
      (widget-language)
      (widget-status)
      (widget-battery)
    )
  )
)
