(defvar languagerev false)
(defpoll language :initial "" :interval "1s" "~/.config/eww/bar/scripts/get-kb.sh")

(defwidget widget-language []
  (eventbox
    :class "bar-lang"
    :onhover "eww update languagerev=true"
    :width 85
    (label :text {language})
  )
)

(defwindow window-language
  :monitor 0
  :geometry (geometry :x "498px"
                      :width "85px"
                      :anchor "top right"
            )
  :stacking "overlay"
  :visible languagerev
  (menu-language)
)

(defwidget menu-language []
  (eventbox
    :class "sm-ph_lang"
    :cursor "pointer"
    :onhoverlost "eww update languagerev=false"
    (revealer
      :reveal languagerev
      :transition "slidedown"
      :duration 650
      (box
        :orientation "v"
        (button
          :class "sm-el_lang-btn${language == 'US' ? '-active' : ''}"
          :onclick "niri msg action switch-layout 0"
          "US"
        )
        (button
          :class "sm-el_lang-btn${language == 'RU' ? '-active' : ''}"
          :onclick "niri msg action switch-layout 1"
          "RU"
        )
      )
    )
  )
)
