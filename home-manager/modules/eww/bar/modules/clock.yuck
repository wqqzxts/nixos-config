(defvar clockrev false)

(defwidget widget-clock []
  (eventbox
    :class "bar-clk"
    :onhover "eww update clockrev=true"
    :width 430
    (label :text {formattime(EWW_TIME, "%A | %B %d | %I:%M %p")})
  )
)

(defwindow window-clock
  :monitor 0
  :geometry (geometry :x "63px"
                      :y "0px"
                      :width "430px"
                      :anchor "top left"
            )
  :stacking "overlay"
  :visible true
  (menu-clock)
)

(defwidget menu-clock []
  (eventbox
    :class "sm-ph_clk"
    :cursor "pointer"
    :onhoverlost "eww update clockrev=false"
    (revealer
      :reveal clockrev
      :transition "slidedown"
      :duration 650
      (box
        :class "sm-ph_clk"
        :orientation "v"
        (calendar
          :class "sm-el_clk-cal"
          :show-heading false
        )
      )
    )
  )
)
