{ config, ... }: {
  programs.zsh = {
    enable = true;
    enableCompletion = true;
    autosuggestion.enable = true;
    syntaxHighlighting.enable = true;

    shellAliases = {
      v = "nvim";
      y = "yazi";

      t = "tmux";
      ta = "tmux new -As ";
      td = "tmux detach";

      gs = "git status";
      ga = "git add";
      gc = "git commit";
      gp = "git push";

      ".." = "cd ..";
      "cl" = "clear";

      ff = "fastfetch";
      nf = "nitch";
    };

    history.size = 10000;
    history.path = "${config.xdg.dataHome}/zsh/history";

    initContent = ''
      # u can uncomment that but i prefer to use tmux without autorun
      # if [ -z "$TMUX" ] && [ -n "$DISPLAY" ]; then
      #   tmux attach-session -t default || tmux new-session -s default
      # fi
    '';

    # maybe cringe but sddm and etc is not my type
    profileExtra = ''
      if [[ "$(tty)" == "/dev/tty1" ]]; then
          exec start-hyprland
      fi
    '';
  };
}
