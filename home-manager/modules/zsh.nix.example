{ config, ... }: {
  programs.zsh = {
    enable = true;
    enableCompletion = true;
    autosuggestion.enable = true;
    syntaxHighlighting.enable = true;

    shellAliases = {
      nu = "nix flake update --flake path:.";
      ns = "sudo nixos-rebuild switch --flake path:.";
      hs = "home-manager switch --flake path:.";
      gc = "nix-collect-garbage -d";

      v = "nvim";
      y = "yazi";

      t = "tmux";
      ta = "tmux new -As ";
      td = "tmux detach";

      gs = "git status";
      ga = "git add";
      gc = "git commit";
      gp = "git push";

      ".." = "cd ..";
      "cl" = "clear";

      ff = "fastfetch";
      nf = "nitch";

    };

    history.size = 10000;
    history.path = "${config.xdg.dataHome}/zsh/history";

    initContent = ''
      # if [ -z "$TMUX" ] && [ -n "$DISPLAY" ]; then
      #   tmux attach-session -t default || tmux new-session -s default
      # fi
    '';

    profileExtra = ''
      if [[ "$(tty)" = "/dev/tty1" ]]; then
        exec niri-session -l
      fi
    '';
  };
}
